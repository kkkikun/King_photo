{
  "_meta": {
    "version": "1.0",
    "description": "Per-format writable metadata field definitions. Based on ExifTool 13.59 official format support table.",
    "last_updated": "2026-06-07",
    "source": "https://exiftool.org/#supported",
    "field_categories": {
      "descriptive": "描述性元数据（标题、描述、作者、版权）——所有支持XMP的格式均可写",
      "camera": "相机信息（品牌、型号、软件、镜头）——需EXIF支持",
      "time": "时间信息（拍摄时间、数字化时间、创建时间）——需EXIF或XMP",
      "technical": "拍摄技术参数（光圈、快门、ISO、焦距、方向）"
    }
  },
  "JPEG": {
    "label": "JPEG 图片",
    "extensions": [
      ".jpg",
      ".jpeg",
      ".jpe"
    ],
    "write_method": "piexif",
    "fallback_method": "exiftool",
    "exif_native": true,
    "xmp_support": true,
    "writable": {
      "descriptive": {
        "title": {
          "field": "ImageDescription",
          "piexif_tag": "ImageDescription",
          "exiftool_tag": "ImageDescription",
          "xmp_tag": "dc:title"
        },
        "description": {
          "field": "ImageDescription",
          "piexif_tag": "ImageDescription",
          "exiftool_tag": "ImageDescription",
          "xmp_tag": "dc:description"
        },
        "artist": {
          "field": "Artist",
          "piexif_tag": "Artist",
          "exiftool_tag": "Artist",
          "xmp_tag": "dc:creator"
        },
        "copyright": {
          "field": "Copyright",
          "piexif_tag": "Copyright",
          "exiftool_tag": "Copyright",
          "xmp_tag": "dc:rights"
        }
      },
      "camera": {
        "make": {
          "field": "Make",
          "piexif_tag": "Make",
          "exiftool_tag": "Make"
        },
        "model": {
          "field": "Model",
          "piexif_tag": "Model",
          "exiftool_tag": "Model"
        },
        "software": {
          "field": "Software",
          "piexif_tag": "Software",
          "exiftool_tag": "Software"
        },
        "lens": {
          "field": "LensModel",
          "piexif_tag": null,
          "exiftool_tag": "LensModel"
        }
      },
      "time": {
        "datetime": {
          "field": "DateTimeOriginal",
          "piexif_tag": "DateTimeOriginal",
          "exiftool_tag": "DateTimeOriginal",
          "xmp_tag": "exif:DateTimeOriginal"
        },
        "datetime_original": {
          "field": "DateTimeOriginal",
          "piexif_tag": "DateTimeOriginal",
          "exiftool_tag": "DateTimeOriginal"
        },
        "datetime_digitized": {
          "field": "DateTimeDigitized",
          "piexif_tag": "DateTimeDigitized",
          "exiftool_tag": "CreateDate"
        },
        "creation_time": {
          "field": "DateTimeOriginal",
          "piexif_tag": "DateTimeOriginal",
          "exiftool_tag": "CreateDate",
          "xmp_tag": "xmp:CreateDate"
        }
      },
      "technical": {
        "exposure_time": {
          "field": "ExposureTime",
          "piexif_tag": "ExposureTime",
          "exiftool_tag": "ExposureTime",
          "note": "曝光时间（秒或分数格式）"
        },
        "fnumber": {
          "field": "FNumber",
          "piexif_tag": "FNumber",
          "exiftool_tag": "FNumber",
          "note": "光圈值"
        },
        "iso": {
          "field": "ISO",
          "piexif_tag": "ISO",
          "exiftool_tag": "ISO",
          "note": "ISO感光度"
        },
        "focal_length": {
          "field": "FocalLength",
          "piexif_tag": "FocalLength",
          "exiftool_tag": "FocalLength",
          "note": "焦距(mm)"
        },
        "orientation": {
          "field": "Orientation",
          "piexif_tag": "Orientation",
          "exiftool_tag": "Orientation",
          "note": "旋转方向(1-8)"
        }
      }
    }
  },
